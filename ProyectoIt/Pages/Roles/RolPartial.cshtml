@page
@model WebUI.Pages.Roles.RolPartialModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
}

<form id="rolForm" method="post">
    <div class="mb-3">
        <label for="Name" class="form-label">Nombre</label>
        <input type="text" id="Name" name="Name" class="form-control" value="@Model.RolDto.Name" />
    </div>

    <div class="mb-3">
        <label for="Estado" class="form-label">Estado</label>
        <input type="checkbox" id="Estado" name="Estado" class="form-check-input" @(Model.RolDto.Estado ? "checked" : null) />
    </div>
    <input type="hidden" name="Id" value="@Model.RolDto.Id" />
    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
</form>
