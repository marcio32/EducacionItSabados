@page "/reportes"
@model WebUI.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes y Analytics";
}

<div class="container-fluid">
    <h2>Reportes y Analytics</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por estado</h5>
                </div>
                <div class="card-body">
                    <canvas id="estadosChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por medico</h5>
                </div>
                <div class="card-body">
                    <canvas id="medicosChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por mes</h5>
                </div>
                <div class="card-body">
                    <canvas id="mensualChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between">
                    <h5>Acciones</h5>
                    <button class="btn btn-primary" onclick="ExportToPDF()">Exportar PDF</button>
                </div>
                <div class="card-body">
                    <button class="btn btn-success me-2" onclick="RefreshCharts()">Actualizar Datos</button>
                    <button class="btn btn-info me-2" onclick="DownloadExcel()">Descargar Excel</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        let estadosChart, medicosChart, mensualChart;

        document.addEventListener('DOMContentLoaded', function(){
            loadCharts();
        });

        async function loadCharts(){

            const response = await fetch('@Url.Page(null, null, new { handler = "Reportes" })',
                {
                    method:'GET'
                }
             );
             const data = await response.json()

             const ctxEstados = document.getElementById('estadosChart').getContext('2d');

             estadosChart  = new Chart(ctxEstados, {
                 type: 'doughnut',
                 data:{
                     labels: ['Pendientes', 'Confirmados', 'Cancelados', 'Realizados'],
                     datasets: [{
                         data: [data.pendientes, data.confirmados, data.cancelados, data.realizados],
                         backgroundColor: ['#ffc107', '#28a745', '#dc3545','#17a2b8']
                     }]
                 },
                 options: {
                     response: true,
                     plugins:{
                         legend: {
                             position: 'bottom'
                         }
                     }
                 }
             })

             const ctxMedicos = document.getElementById('medicosChart').getContext('2d');
             medicosChart  = new Chart(ctxMedicos, {
                 type: 'bar',
                 data:{
                     labels: ['Dr. Perez', 'Dra. Fernandez', 'Dr. Garcia'],
                     datasets: [{
                        label: 'Turnos',
                        data: [12, 8 ,15],
                        backgroundColor:'#007bff'
                     }]
                 },
                 options: {
                     response: true,
                    scales: {
                        y:{
                          beginAtZero: true
                        }
                    }
                 }
             })

             const ctxMensual = document.getElementById('mensualChart').getContext('2d');
             mensualChart  = new Chart(ctxMensual, {
                 type: 'line',
                 data:{
                     labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                     datasets: [{
                        label: 'Turnos por mes',
                        data: [2, 8, 4, 26, 90 ,15],
                        boderColor: '#28a745',
                        backgroundColor:'rgba(40,167,69, 1)',
                        tension: 0.4
                     }]
                 },
                 options: {
                     response: true,
                    scales: {
                        y:{
                          beginAtZero: true
                        }
                    }
                 }
             })

        }

             function RefreshCharts(){
                 estadosChart.destroy();
                 medicosChart.destroy();
                 mensualChart.destroy();
                 loadCharts();
             }

             function ExportToPDF(){
                 const { jsPDF} = window.jspdf;
                 const doc = new jsPDF();

                 doc.setFontSize(20);
                 doc.text('Reporte de turnos', 20, 40);

                 doc.setFontSize(12);
                 doc.text('Fecha: ' + new Date().toLocaleDateString(), 20, 40);
                 doc.text('Este reporte contiene estadisticas de turnos medicos,', 20, 50);

                 doc.save('reporte-turnos.pdf')

             }

             function DownloadExcel(){
                 alert('Descargar Excel;');
             }

    </script>
}