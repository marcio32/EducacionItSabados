@page "/reportes"
@model WebUI.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes y Analytics";
}

<div class="container-fluid">
    <h2>Reportes y Analytics</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por estado</h5>
                </div>
                <div class="card-body">
                    <canvas id="estadosChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por medico</h5>
                </div>
                <div class="card-body">
                    <canvas id="medicosChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Turnos por mes</h5>
                </div>
                <div class="card-body">
                    <canvas id="mensualChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <button class="btn btn-success me-2" onclick="RefreshCharts()">Actualizar Datos</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        let estadosChart, medicosChart, mensualChart;

        document.addEventListener('DOMContentLoaded', function(){
            loadCharts();
        });

        async function loadCharts(){

            var response = await fetch('@Url.Page(null, null, new { handler = "Reportes" })',
                {
                    method:'GET'
                }
             );
             var data = await response.json()
             const ctxEstados = document.getElementById('estadosChart').getContext('2d');
             var labels = ['Pendientes', 'Confirmados', 'Cancelados', 'Realizados'];
             var valores = [data.pendientes,data.confirmados,data.cancelados, data.realizados, data.hoy];
             var colores = ['#ffc107', '#28a745', '#dc3545','#17a2b8'];
             debugger
             estadosChart = Charts(ctxEstados, labels, valores, 'doughnut', colores);

             response = await fetch('@Url.Page(null, null, new { handler = "ReportesMedicos" })',
                {
                    method:'GET'
                }
             );

             data = await response.json();
             labels = data.map(x=> x.medicoNombre);
             valores = data.map(x=> x.total);

             const ctxMedicos = document.getElementById('medicosChart').getContext('2d');


             medicosChart = Charts(ctxMedicos, labels, valores, 'bar');

             response = await fetch('@Url.Page(null, null, new { handler = "ReportesMensual" })',
                {
                    method:'GET'
                }
             );

             data = await response.json();
             labels = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
             valores = data.map(x=> x.total);

             const ctxMensual = document.getElementById('mensualChart').getContext('2d');

             mensualChart = Charts(ctxMensual, labels, valores, 'line');
        }

        function RefreshCharts(){
                 estadosChart.destroy();
                 medicosChart.destroy();
                 mensualChart.destroy();
                 loadCharts();
             }

        function Charts(ctx, label, datas, types, colors = '#dc3545'){
            var result = new Chart(ctx, {
                 type: types,
                 data:{
                     labels: label,
                     datasets: [{
                         data: datas,
                         backgroundColor: colors
                     }]
                 },
                 options: {
                     response: true,
                     plugins:{
                         legend: {
                             position: types === 'doughnut' ? 'bottom' : ''
                         }
                     }
                 }
             })

             return result;
        }
    </script>
}